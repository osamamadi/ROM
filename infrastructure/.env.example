# Copy this file's values into the Railway project's Variables tab (or a local
# .env loaded by your process manager) — never commit a real .env file.
# None of these are secrets; MODEL_URL is a public Google Drive share link.

# Google Drive share link for the v2 checkpoint (epoch_160.pth), fetched with
# gdown on startup. Default points at the current production checkpoint.
MODEL_URL=https://drive.google.com/uc?id=1WVB3HL6lhEHg8uQCbAmC_Ed8lOAtHalx

# Where the downloaded checkpoint is cached inside the container.
MODEL_PATH=/app/weights/epoch_160.pth

# MMPose training config to load, relative to infrastructure/.
MODEL_CONFIG=configs/hrnet_w32_ankle_v2.py

# cpu or cuda:0
DEVICE=cpu

# Comma-separated list of origins allowed to call the API (your Vercel URL(s)).
ALLOWED_ORIGINS=http://localhost:3000

# Torch CPU thread count.
TORCH_THREADS=2
